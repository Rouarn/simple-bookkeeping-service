# ============================================================
# simple-bookkeeping-service 环境变量示例
#
# 用法：复制为 .env.development（本地开发）或 .env.production（线上），再逐项替换占位值。
#   本地：cp .env.example .env.development
#   线上：cp .env.example .env.production
# 加载时机：src/config/config.module.ts 按 NODE_ENV 选择文件；标注【必填】的键缺失或为空时启动即 fail-fast
# （src/config/env.validation.ts）。密钥类占位值写成 change-me 会被弱密钥校验直接拒绝，必须换成随机值。
# 每条注释三段：① 用途 + 必填/可选 + 默认值 ② 格式或示例 ③ 取值来源与约束。
# ============================================================

# ---------- 服务基础 ----------

# NODE_ENV：运行环境标识，决定加载哪个 env 文件、TypeORM 是否 synchronize、Swagger 默认开关、日志级别。【必填】默认 development
# 示例：development | production | test（仅此三值）
# 取值：本地填 development，线上填 production；填错会在生产库上自动同步表结构
NODE_ENV=development

# PORT：HTTP 监听端口（进程实际监听 0.0.0.0）。【可选】默认 3000，允许 1–65535
# 示例：3000
# 取值：本机自选空闲端口；线上须与 nginx upstream、防火墙放行端口保持一致
PORT=3000

# CORS_ORIGINS：允许的跨域来源白名单，逗号分隔；留空表示不放行任何跨域来源。【production 必填】默认空
# 示例：http://localhost:5173,http://localhost:3000（逐条校验形态：仅 http(s)://host[:port]、不含路径、禁止通配符 *）
# 取值：填 H5 域名 / 小程序管理后台域名；生产环境还拒绝空值与 localhost/127.0.0.1，否则启动即失败（P2-13）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TRUST_PROXY_HOPS：Express 采信的反向代理层数，决定从 X-Forwarded-For 取真实客户端 IP。【可选】默认 1，允许 0–10
# 示例：1（单层 nginx 反代）| 0（服务直连公网，无代理）
# 取值：nginx 反代填 1；直连必须填 0，否则 XFF 可被伪造，绕过基于 IP 的限流与登录失败计数
TRUST_PROXY_HOPS=1

# ---------- MySQL ----------

# DB_HOST：MySQL 主机地址。【必填】无默认值
# 示例：127.0.0.1 | db.internal
# 取值：本机实例填 127.0.0.1；远程库填其地址并放行端口，只对可信网段开放
DB_HOST=127.0.0.1

# DB_PORT：MySQL 端口。【可选】默认 3306，允许 1–65535
# 示例：3306
# 取值：与 DB_HOST 实例的监听端口一致
DB_PORT=3306

# DB_USER：MySQL 账号。【必填】无默认值
# 示例：app
# 取值：生产用仅授予业务库最小权限的专用账号，不要用 root
DB_USER=app

# DB_PASSWORD：MySQL 密码。【production 必填，为空启动失败】默认空字符串
# 示例：<强随机口令>（不要保留 change-me 占位）
# 取值：数据库侧创建账号时设定；线上只写入本机 .env.production，勿入库
DB_PASSWORD=change-me

# DB_NAME：业务库库名。【必填】无默认值
# 示例：simple-bookkeeping
# 取值：已在 MySQL 中创建、字符集 utf8mb4 的库；生产 synchronize 永久关闭，表结构变更须手工执行 DDL
DB_NAME=simple-bookkeeping

# DB_CONNECTION_LIMIT：mysql2 连接池上限。【可选】默认 10，允许 1–100
# 示例：10
# 取值：按 QPS 与数据库 max_connections 设置；多实例部署时各实例之和不得超过数据库上限
DB_CONNECTION_LIMIT=10

# DB_TLS：是否以 TLS 加密连接 MySQL。【可选】默认 false；值为 true/1/yes/on 视为开启
# 示例：true（公网或跨机房链路建议开启）
# 取值：数据库已启用 TLS 时开启；同机 127.0.0.1 连接可保持关闭
DB_TLS=false

# DB_TLS_REJECT_UNAUTHORIZED：TLS 连接是否校验服务端证书。【可选】默认 true
# 示例：true | false
# 取值：MySQL 5.7 自签证书且无法导入 CA 时才改为 false（等于放弃中间人防护），生产有正式证书时保持 true
DB_TLS_REJECT_UNAUTHORIZED=true

# ---------- Redis ----------

# REDIS_HOST：Redis 主机地址。【必填】无默认值
# 示例：127.0.0.1 | redis.internal
# 取值：限流计数、字典缓存、登录锁定、幂等键与定时任务选主锁都依赖它；断连时相关能力降级但仍可服务
REDIS_HOST=127.0.0.1

# REDIS_PORT：Redis 端口。【可选】默认 6379，允许 1–65535
# 示例：6379
# 取值：与 REDIS_HOST 实例的监听端口一致
REDIS_PORT=6379

# REDIS_PASSWORD：Redis 口令。【production 必填，为空启动失败】默认空（不认证）
# 示例：<强随机口令>（不要保留 change-me 占位）
# 取值：Redis requirepass 的值，建议同步开启 protected-mode 与内网访问限制（P1-05）
REDIS_PASSWORD=change-me

# REDIS_DB：使用的 Redis 逻辑库编号。【可选】默认 0，允许 0–15
# 示例：0
# 取值：同一实例被多项目共用时各项目分库；Redis Cluster 只支持 0 号库
REDIS_DB=0

# REDIS_TLS：是否以 TLS 加密连接 Redis。【可选】默认 false；值为 true/1/yes/on 视为开启
# 示例：true（云托管 Redis 或跨公网链路建议开启）
# 取值：Redis 服务端已启用 TLS 时开启；同机内网直连可保持关闭（P1-05）
REDIS_TLS=false

# ---------- 认证与令牌 ----------

# JWT_ACCESS_SECRET：access token 的 HS256 签名密钥。【必填】无默认值，>=32 字节、字符种类 >=3 类，且不得含弱密钥片段
# 示例：openssl rand -base64 48 生成，access/refresh/pepper 各生成一份
# 取值：自行随机生成，dev/prod 隔离；与 JWT_REFRESH_SECRET 相同会被启动校验拒绝，含 change-me/secret/example 等片段同样被拒
JWT_ACCESS_SECRET=change-me-to-a-random-32+-byte-secret

# JWT_REFRESH_SECRET：refresh token 的 HS256 签名密钥。【必填】无默认值，强度要求同上
# 示例：openssl rand -base64 48 生成（与 access 密钥分别生成）
# 取值：自行随机生成；与 JWT_ACCESS_SECRET 不得相同
JWT_REFRESH_SECRET=change-me-to-a-random-32+-byte-secret

# JWT_ACCESS_TTL：access token 有效期。【可选】默认 30m，支持 s/m/h/d 单位或纯秒数
# 示例：30m | 2h | 1800
# 取值：默认 30m 配合 token_version 体系（改密/全员登出即时吊销）缩短失陷窗口（P1-01），不宜拉长
JWT_ACCESS_TTL=30m

# JWT_REFRESH_TTL：refresh token 有效期，同时决定 refresh_tokens 行的过期时间。【可选】默认 30d，单位同上
# 示例：7d | 30d | 2592000
# 取值：按「多久不登录需重新输密码」的产品预期设定
JWT_REFRESH_TTL=30d

# REFRESH_PEPPER：refresh token 入库哈希用的服务端胡椒（HMAC-SHA256(pepper, token)）。【必填】无默认值，>=32 字节
# 示例：openssl rand -base64 48 生成，一密一用
# 取值：自行随机生成，勿与 JWT/FILES_SIGN 密钥重复；库泄漏时无 pepper 无法离线还原 refresh token（P2-13）
REFRESH_PEPPER=change-me-to-a-random-32+-byte-secret

# ---------- Swagger 接口文档 ----------

# ENABLE_SWAGGER：是否挂载 /api/docs 接口文档。【可选】默认 development 为 true、production 为 false
# 示例：false | true
# 取值：仅内网联调阶段在生产临时开启；开启后必须同时配置下方 Basic Auth，否则启动校验失败（P2-13）
ENABLE_SWAGGER=false

# SWAGGER_BASIC_USER：文档页 HTTP Basic Auth 账号。【ENABLE_SWAGGER=true 且 production 时必填】
# 示例：docs-reader
# 取值：临时给联调同事的只读账号；不要在公网长期开启文档
SWAGGER_BASIC_USER=

# SWAGGER_BASIC_PASSWORD：文档页 HTTP Basic Auth 密码。【ENABLE_SWAGGER=true 且 production 时必填】要求 >=16 字节
# 示例：<至少 16 字节的随机口令>
# 取值：自行生成；与业务账号口令无关，仅在文档页生效（P2-13）
SWAGGER_BASIC_PASSWORD=

# ---------- 文件上传与签名访问 ----------

# UPLOAD_DIR：图片存储根目录（相对路径基于进程工作目录）。【必填】配置默认值 ./uploads，但启动校验要求非空
# 示例：./uploads（开发）| /data/bookkeeping/uploads（生产）
# 取值：目录须存在且进程可写（启动时会创建并 chmod 0700，不可写即 fail-fast）；生产不要指向部署包目录
UPLOAD_DIR=./uploads

# FILES_BASE_URL：签名图片 URL 的对外基址（末尾斜杠会被自动去掉）。【可选】默认 http://localhost:3000/api/v1/files
# 示例：http://localhost:3000/api/v1/files | https://xl.shixian.xyz/api/v1/files
# 取值：填客户端可访问的 /api/v1/files 完整前缀；APP 端强制 https，不要配成 nginx 静态目录直出
FILES_BASE_URL=http://localhost:3000/api/v1/files

# FILES_SIGN_SECRET：图片访问签名（HMAC-SHA256，签 key+'.'+过期时间）密钥。【必填】无默认值，>=32 字节、字符种类 >=3 类
# 示例：openssl rand -base64 48 生成（与 JWT 密钥独立）
# 取值：自行随机生成；与 JWT 密钥相同会被启动校验拒绝，更换后已发出的签名 URL 全部失效
FILES_SIGN_SECRET=change-me-to-a-random-32+-byte-secret

# FILES_LINK_TTL：签名 URL 有效期（秒）。【可选】默认 1800，允许 60–604800
# 示例：1800（30 分钟）| 900（15 分钟）
# 取值：私密凭证建议 15~60 分钟；过长等于延长 URL 被转发后的可用窗口（P2-09）
FILES_LINK_TTL=1800

# UPLOAD_MAX_SIZE_MB：单张图片上传体积上限（MB），由 Multer 内存接收后校验。【可选】默认 5，允许 1–50
# 示例：5
# 取值：需小于等于 nginx client_max_body_size（README 示例给 10m），否则大图在反代层就被拒
UPLOAD_MAX_SIZE_MB=5

# UPLOAD_BILL_MAX_EDGE：账单凭证图重编码后的最大边长（像素）。【可选】默认 1440，允许 64–4096
# 示例：1440
# 取值：等比缩放到该边长内（不放大原图）；按清晰度与存储成本权衡
UPLOAD_BILL_MAX_EDGE=1440

# UPLOAD_AVATAR_MAX_EDGE：头像重编码后的最大边长（像素）。【可选】默认 512，允许 64–4096
# 示例：512 | 256
# 取值：按界面展示尺寸设定，头像不需要大图
UPLOAD_AVATAR_MAX_EDGE=512

# ---------- 账号注销 ----------

# USER_DEACTIVATION_RETENTION_DAYS：注销账号的业务数据保留期（天），期满由每日 03:40 清理任务回收账单/账本/消息等。【可选】默认 30，允许 1–3650
# 示例：30（users 匿名行保留作审计，仅清业务数据与图片文件）
# 取值：按合规/客服追溯需要设定；当前默认注释掉，需要调整时取消注释并改值
# USER_DEACTIVATION_RETENTION_DAYS=30
